# AWS SageMaker Configuration
# Copy this to .env and update with your values

# Required: Your SageMaker execution role ARN
SAGEMAKER_ROLE=arn:aws:iam::YOUR_ACCOUNT_ID:role/SageMakerExecutionRole

# Optional: AWS Region (defaults to us-east-1)
AWS_REGION=us-east-1

# Optional: AWS Profile to use (defaults to default)
AWS_PROFILE=default
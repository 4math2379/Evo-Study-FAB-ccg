# AWS SageMaker Configuration
# Copy this to .env and update with your values

# Required: Your SageMaker execution role ARN
SAGEMAKER_ROLE=arn:aws:iam::YOUR_ACCOUNT_ID:role/SageMakerExecutionRole

# Optional: AWS Region (defaults to us-east-1)
AWS_REGION=us-east-1

# Optional: AWS Profile to use (defaults to default)
AWS_PROFILE=default

# Hugging Face: pushing models, and LLM calls through Inference Providers (ai_gateway.py)
HF_TOKEN=hf_your_token_here

# Optional: LLM settings for ai_gateway.py
# LLM_MODEL=openai/gpt-oss-120b
# Another OpenAI-compatible endpoint you trust, with its own key (HF_TOKEN is never sent there)
# LLM_BASE_URL=
# LLM_API_KEY=